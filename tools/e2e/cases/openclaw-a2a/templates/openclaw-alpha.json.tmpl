{
  "models": {
    "mode": "merge",
    "providers": {
      "bailian": {
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "apiKey": {{json:DASHSCOPE_KEY}},
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen4-max",
            "name": "qwen4-max",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 262144,
            "maxTokens": 65536
          }
        ]
      }
    }
  },
  "agents": {"defaults": {"model": {"primary": "bailian/qwen4-max"}}},
  "plugins": {
    "enabled": true,
    "allow": ["cai-pep", "cai-a2a"],
    "entries": {
      "cai-pep": {
        "enabled": true,
        "config": {
          "socketPath": "/run/cai/pep.sock",
          "pepRequired": true,
          "defaultWorkdir": "/workspace"
        }
      },
      "cai-a2a": {
        "enabled": true,
        "config": {
          "timeoutMs": 240000,
          "auditPath": {{json:A2A_AUDIT_PATH}},
          "auditRequired": true,
          "peers": {
            "beta": {
              "token": {{json:BETA_TOKEN}}
            }
          }
        }
      }
    }
  },
  "channels": {},
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {"mode": "token", "token": {{json:ALPHA_TOKEN}}},
    "http": {"endpoints": {"responses": {"enabled": true}}},
    "controlUi": {
      "enabled": true,
      "basePath": "/openclaw",
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "dangerouslyDisableDeviceAuth": true
    }
  }
}
